{
  "name": "consolex-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ConsoleX — personal software ecosystem portfolio. Built with React, TypeScript, Vite and Tailwind CSS.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "db:push": "node -e \"console.log('[consolex] no database in this project — no-op for env compatibility')\""
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@fontsource/dm-mono": "^5.2.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.545.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.4"
